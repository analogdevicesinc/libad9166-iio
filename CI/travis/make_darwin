if [ "x${COVERITY_SCAN_PROJECT_NAME}" != "x" ] ; then exit 0; fi

mkdir -p build

# CalibrateTest opens an iio context to a real AD9166/CN0511 board; on macOS
# (no 'local:' backend, no hardware in CI) the test binary crashes on launch,
# so skip the test run here.
cd build
cmake -DOSX_PACKAGE=ON -DCMAKE_BUILD_TYPE="${CMAKE_BUILD_TYPE:-Release}" ..
make
ls

cd ..

mkdir -p build_tar

cd build_tar
cmake -DOSX_PACKAGE=OFF -DENABLE_PACKAGING=ON -DCMAKE_BUILD_TYPE="${CMAKE_BUILD_TYPE:-Release}" ..
make
ls
make package
